# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Optional overrides (these are the defaults)
# STT_MODEL=whisper-large-v3
# REFINE_MODEL=openai/gpt-oss-20b
# MINUTES_MODEL=openai/gpt-oss-120b
# REFINE_REASONING=medium
# MINUTES_REASONING=medium
# DIARIZATION=false          # true = detect who is speaking by default
# TPM_BUDGET=0               # tokens per request; 0 = read the limit from the API (free tier = 8000)
# LLM_BASE_URL=https://api.groq.com/openai/v1   # any OpenAI-compatible API works
# PERSIST_RUNS=true          # keep past meetings in ./runs (set false on a public server)
# MAX_UPLOAD_MB=300

# Free key daily allowance per signed-in user, in audio minutes (0 = no limit)
# FREE_DAILY_MINUTES=60
# QUOTA_TZ=Asia/Kolkata

# Speech-to-text on a different provider than the language models (optional)
# STT_BASE_URL=https://api.groq.com/openai/v1
# STT_API_KEY=gsk_...

# "Sign in with Google" is configured in .streamlit/secrets.toml, see .streamlit/secrets.toml.example and docs/DEPLOY.md
