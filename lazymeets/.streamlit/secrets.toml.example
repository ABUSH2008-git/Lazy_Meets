# Copy this into Streamlit Cloud: your app -> Settings -> Secrets
# (or save it locally as .streamlit/secrets.toml, which is git-ignored).

# The free, preloaded key that visitors can use (Groq: https://console.groq.com/keys)
GROQ_API_KEY = "gsk_your_key_here"

# How much audio each signed-in person may process per day with the free key (0 = no limit)
FREE_DAILY_MINUTES = "60"

# Keep each person's past meetings (they only ever see their own)
PERSIST_RUNS = "true"

# "Sign in with Google". Leave this whole block out to run without sign-in (fine on your own computer).
[auth]
redirect_uri = "https://YOUR-APP.streamlit.app/oauth2callback"
cookie_secret = "a-long-random-string"   # python -c "import secrets; print(secrets.token_hex(32))"

[auth.google]
client_id = "1234567890-abc.apps.googleusercontent.com"
client_secret = "GOCSPX-..."
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
client_kwargs = { prompt = "select_account" }   # always show Google's "choose an account" screen
